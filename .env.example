# Copy this file to .env and fill in real values locally.
# .env is git-ignored and must NEVER be committed.

# =========================================================================
# Surf application database (surf_data)
# =========================================================================
# Two different "DB_HOST" concepts, kept separate on purpose:
#
#   * DB_HOST              -> host-side tools ONLY (Streamlit, local Python
#                             scripts). On Windows this stays `localhost`.
#
#   * AIRFLOW_SURF_DB_HOST -> the address the Airflow/dbt/ingestion
#                             CONTAINERS use to reach surf_data.
#
#     LOCAL (Windows) : leave it as host.docker.internal -> containers reach
#                       your existing Windows PostgreSQL through host-gateway.
#
#     AWS (EC2)       : set it to `surf-db` -> the dockerized PostgreSQL 18
#                       service from docker-compose.yml. Port 5432 is
#                       published intentionally so Streamlit Cloud can
#                       connect remotely (read-only role); restrict inbound
#                       access to it via the EC2 security group.
#
# Containers never reuse the host-side DB_HOST=localhost (localhost inside a
# container is not the Windows PostgreSQL), so the two stay independent.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=surf_data
DB_USER=replace-with-surf-db-user
DB_PASSWORD=replace-with-surf-db-password

# Container-side address of surf_data. host.docker.internal = local Windows
# PostgreSQL; set to surf-db on AWS.
AIRFLOW_SURF_DB_HOST=host.docker.internal

# Existing Copernicus credentials; values are supplied locally, never committed.
COPERNICUS_USERNAME=replace-with-copernicus-username
COPERNICUS_PASSWORD=replace-with-copernicus-password

# =========================================================================
# Airflow metadata database (separate from surf_data, always dockerized)
# =========================================================================
AIRFLOW_META_DB_NAME=airflow_meta
AIRFLOW_META_DB_USER=airflow
AIRFLOW_META_DB_PASSWORD=replace-with-a-url-safe-random-secret

# Airflow API/authentication secrets. Generate locally; do not commit real keys.
AIRFLOW_FERNET_KEY=replace-with-a-generated-fernet-key
AIRFLOW_API_SECRET_KEY=replace-with-a-random-secret
AIRFLOW_JWT_SECRET=replace-with-a-random-secret

# SimpleAuthManager creates this account with the admin role and generates its
# password locally. The generated password is persisted in the airflow_auth volume.
AIRFLOW_ADMIN_USERNAME=airflow